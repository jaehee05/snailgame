# Firebase 서비스 계정 (필수)
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → "새 비공개 키 생성" 으로 받은 JSON.
# JSON 원문을 통째로 넣거나, base64 로 인코딩한 문자열을 넣어도 된다.
#   base64 -i serviceAccount.json | pbcopy
FIREBASE_SERVICE_ACCOUNT=

# 세션 쿠키 서명 키 (배포 시 반드시 설정할 것)
# 바뀌면 모두 로그아웃되고, 노출되면 남의 세션을 위조할 수 있다.
#   openssl rand -hex 32
AUTH_SECRET=

# 회차 시드 생성용 비밀키 (배포 시 반드시 설정할 것)
# 노출되면 미래 회차의 결과를 미리 계산할 수 있다.
#   openssl rand -hex 32
ROUND_SECRET=

# 관리자로 자동 승격할 아이디 (쉼표 구분, 선택)
# 비워두면 가장 먼저 가입한 사람이 관리자가 된다.
ADMIN_NICKS=
